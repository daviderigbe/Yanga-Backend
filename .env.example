# Kwik staging dispatch integration
DISPATCH_MODE=manual
DISPATCH_PROVIDER=KWIK
DISPATCH_BASE_FEE_NAIRA=1500
DISPATCH_EXTRA_ITEM_FEE_NAIRA=200

# Marketplace revenue settings
PLATFORM_COMMISSION_RATE=0.1
BUYER_SERVICE_FEE_RATE=0
BUYER_SERVICE_FEE_NAIRA=200
DELIVERY_MARKUP_RATE=0
DELIVERY_MARKUP_NAIRA=0

# Email verification
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_SECURE=false
EMAIL_FROM=
EMAIL_FROM_NAME=AFRAB

DISPATCH_PICKUP_NAME=AFRA B Fulfilment
DISPATCH_PICKUP_PHONE=
DISPATCH_PICKUP_EMAIL=
DISPATCH_PICKUP_ADDRESS=
DISPATCH_PICKUP_CITY=Lagos
DISPATCH_PICKUP_STATE=Lagos
DISPATCH_PICKUP_LATITUDE=
DISPATCH_PICKUP_LONGITUDE=

KWIK_API_BASE_URL=https://staging-api-test.kwik.delivery
KWIK_DOMAIN_NAME=staging-client-panel.kwik.delivery
KWIK_EMAIL=
KWIK_PASSWORD=

# Optional static session values. Leave empty to use automatic /vendor_login.
KWIK_ACCESS_TOKEN=
KWIK_VENDOR_ID=
KWIK_USER_ID=
KWIK_CUSTOMER_ID=

KWIK_FORM_ID=2
KWIK_VEHICLE_ID=1
KWIK_PAYMENT_METHOD=524288
KWIK_TIMEZONE=-60
KWIK_AUTO_ASSIGNMENT=1
KWIK_TEAM_ID=
KWIK_CUSTOM_FIELD_TEMPLATE=pricing-template
