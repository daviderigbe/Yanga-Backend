generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  emailVerified   Boolean   @default(false)
  password        String? // Optional because of social login
  name            String?
  imageUrl        String?
  bio             String?
  userName        String?   @unique
  bankCode        String?
  bankName        String?
  bankAccountName String?
  isDeactivated   Boolean   @default(false)
  deactivatedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Authentication
  sessions Session[]
  googleId String?   @unique
  appleId  String?   @unique

  // Shop settings
  enableBundleBuying Boolean @default(false)
  userUnavailable    Boolean @default(false)

  // Addresses
  addresses Address[]

  // Payment
  savedCards SavedCard[]

  // Products
  products       Product[] // Products they're selling
  likedProducts  Like[]
  productsBought Order[] // Products they've bought
  reviews        Review[] // Reviews they've written

  // Social
  followers Follow[] @relation("UserFollowers") // People who follow this user
  following Follow[] @relation("UserFollowing") // People this user follows

  // Messages
  messagesSent Message[] @relation("MessageSender")

  // Notifications
  notifications Notification[]
  cart          Cart?

  // Conversations
  conversationsAsMemberOne Conversation[] @relation("ConversationMemberOne")
  conversationsAsMemberTwo Conversation[] @relation("ConversationMemberTwo")

  // Product views
  productViews ProductView[]

  // Web socket tokens
  wsToken WsToken[]

  // Brand ownership
  ownedBrands Brand[] @relation("BrandOwner")

  @@index([email])
  @@index([userName])
}

/// Session information for authenticated users
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// WebSocket connection tokens
model WsToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

/// Product listings in the marketplace
model Product {
  id              String        @id @default(uuid())
  sellerId        String
  seller          User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title           String
  description     String
  basePrice       Decimal
  discountPercent Float?
  status          ProductStatus @default(DRAFT)
  condition       Condition
  size            String // XS, S, M, L, XL, 40, 41, etc.
  gender          Gender
  color           String

  // Updated brand relationship
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  // Categories and Tags
  categories CategoriesOnProducts[]
  tags       TagsOnProducts[]

  // Media and Engagement
  images  ProductImage[]
  likes   Like[]
  reviews Review[]

  // Orders
  orderItems OrderItem[]

  // Timestamps and Metadata
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  isAvailable  Boolean       @default(true)
  cartItem     CartItem[]
  messages     Message[]
  productViews ProductView[]

  @@index([sellerId])
  @@index([brandId])
  @@index([status])
  @@index([gender])
  @@index([condition])
}

/// Images associated with a product
model ProductImage {
  id        String  @id @default(uuid())
  url       String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Int     @default(0) // For image ordering

  @@index([productId])
}

/// Tracks product view events
model ProductView {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  viewedAt  DateTime @default(now())

  @@index([productId])
  @@index([userId])
  @@index([viewedAt])
}

model Brand {
  id                  String  @id @default(uuid())
  name                String  @unique
  description         String?
  logoUrl             String?
  contactAddress      String?
  businessPhoneNumber String?

  // Brand ownership and verification
  ownerId           String
  owner             User        @relation("BrandOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  status            BrandStatus @default(PENDING)
  verificationNotes String? // Notes from admin during verification

  // Certification documents
  certificationFiles BrandCertification[]

  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  verifiedAt DateTime? // When the brand was verified
  verifiedBy String? // Admin user ID who verified

  @@index([name])
  @@index([ownerId])
  @@index([status])
}

/// Brand certification documents
model BrandCertification {
  id         String   @id @default(uuid())
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  fileUrl    String
  fileName   String
  fileType   String // pdf, jpg, png, etc.
  fileSize   Int // in bytes
  uploadedAt DateTime @default(now())

  @@index([brandId])
}

/// Product categories
model Category {
  id       String                 @id @default(uuid())
  name     String                 @unique
  products CategoriesOnProducts[]

  @@index([name])
}

model CategoriesOnProducts {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

/// Product tags for improved searching and filtering
model Tag {
  id       String           @id @default(uuid())
  name     String           @unique // casual, modern, vintage, etc.
  products TagsOnProducts[]

  @@index([name])
}

/// Junction table for the many-to-many relationship between products and tags
model TagsOnProducts {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([productId])
  @@index([tagId])
}

/// Product likes/favorites from users
model Like {
  id        String   @id @default(uuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

/// Product reviews and ratings
model Review {
  id          String   @id @default(uuid())
  rating      Int
  description String?
  userId      String
  productId   String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([productId])
}

/// Orders placed by users
model Order {
  id           String      @id @default(uuid())
  buyerId      String
  buyer        User        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  status       OrderStatus @default(PENDING)
  isBundle     Boolean     @default(false)
  totalAmount  Decimal     @db.Decimal(10, 2)
  discountCode String?
  addressId    String
  address      Address     @relation(fields: [addressId], references: [id], onDelete: Restrict)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([buyerId])
  @@index([addressId])
  @@index([status])
  @@index([createdAt])
}

/// Individual items within an order
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  price     Decimal @db.Decimal(10, 2) // Price at time of purchase

  @@index([orderId])
  @@index([productId])
}

/// Shopping cart for users
model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

/// Items in a user's shopping cart
model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

/// User addresses for shipping and billing
model Address {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AddressType
  street    String
  city      String
  state     String
  country   String
  zipCode   String
  orders    Order[]
  isDefault Boolean     @default(false)

  @@index([userId])
}

/// Saved payment methods
model SavedCard {
  id          String  @id @default(uuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  last4       String
  brand       String
  expiryMonth Int
  expiryYear  Int
  isDefault   Boolean @default(false)

  @@index([userId])
}

/// User follow relationships
model Follow {
  id          String   @id @default(uuid())
  followerId  String // The user who is doing the following
  followingId String // The user who is being followed
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

/// Conversations between users
model Conversation {
  id          String    @id @default(uuid())
  memberOneId String
  memberOne   User      @relation("ConversationMemberOne", fields: [memberOneId], references: [id], onDelete: Cascade)
  memberTwoId String
  memberTwo   User      @relation("ConversationMemberTwo", fields: [memberTwoId], references: [id], onDelete: Cascade)
  messages    Message[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([memberOneId, memberTwoId])
  @@index([memberOneId])
  @@index([memberTwoId])
}

/// Messages sent between users
model Message {
  id             String       @id @default(uuid())
  content        String
  fileUrl        String?
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([senderId])
  @@index([conversationId])
  @@index([productId])
  @@index([createdAt])
}

/// User notifications
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  content   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

/// Discount codes for orders
model DiscountCode {
  id         String   @id @default(uuid())
  code       String   @unique
  percentage Float
  validFrom  DateTime
  validUntil DateTime
  maxUses    Int?
  usedCount  Int      @default(0)
  isActive   Boolean  @default(true)

  @@index([code])
  @@index([isActive])
  @@index([validUntil])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD
  DELETED
}

enum Condition {
  NEW
  OPEN_BOX
  LIKE_NEW
  LIGHTLY_USED
  FAIRLY_USED
  HEAVILY_USED
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum AddressType {
  BILLING
  SHIPPING
}

enum NotificationType {
  PRODUCT_SOLD
  NEW_FOLLOWER
  NEW_MESSAGE
  ORDER_STATUS
  NEW_PRODUCT_FROM_FOLLOWING
  PRICE_DROP
  BRAND_VERIFICATION_STATUS
}

enum BrandStatus {
  PENDING // Awaiting verification
  VERIFIED // Approved by admin
  REJECTED // Rejected by admin
  DRAFT // Saved as draft by user
}
