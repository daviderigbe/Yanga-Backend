{
  "name": "yanga-backend",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --target=bun ./src/index.ts --outdir ./build && cp package.json build/",
    "start": "cd build && bun run index.js",
    "seed": "bun seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.832.0",
    "@aws-sdk/s3-request-presigner": "^3.832.0",
    "@bogeychan/elysia-logger": "^0.1.7",
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/swagger": "^1.2.0",
    "@faker-js/faker": "^10.0.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@prisma/client": "6.2.1",
    "@types/nodemailer": "^6.4.17",
    "arctic": "^3.6.1",
    "elysia": "latest",
    "google-auth-library": "^9.15.1",
    "mailtrap": "^4.0.0",
    "nodemailer": "^6.10.0",
    "pino-pretty": "^13.0.0",
    "redis": "^4.7.0",
    "resend": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "bun-types": "latest",
    "prisma": "^6.2.1"
  },
  "module": "src/index.js"
}
